#!/usr/bin/env bash
# ============================================================================
# FLEAD Platform Shutdown Script (Linux/macOS/WSL)
# Stops all Docker services and cleans up containers
# Usage: ./stop
# ============================================================================
set -e

# Go to repo root (directory of this script)
cd "$(dirname "$0")"

echo
echo "==================================================="
echo "FEDERATED LEARNING PLATFORM - SHUTDOWN (POSIX)"
echo "==================================================="
echo

echo "Stopping all services..."
echo

# Stop and remove ONLY this project's containers. Data volumes (TimescaleDB,
# Kafka, Grafana, models) are kept for the next ./start.
# The previous version killed every container on the machine and pruned every
# unused Docker volume, wiping other apps' data.
echo "Stopping FLEAD containers..."
if docker compose version >/dev/null 2>&1; then
  docker compose --profile data down --remove-orphans || true
elif command -v docker-compose >/dev/null 2>&1; then
  docker-compose --profile data down --remove-orphans || true
fi
echo "Done."

# Containers from older runs that may not be tracked by compose
docker container rm -f data-preprocessor jupyter-dev 2>/dev/null || true
echo

echo "==================================================="
echo "SHUTDOWN COMPLETE (POSIX)"
echo "==================================================="
echo "To start again: ./start"
echo
