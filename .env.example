# FLEAD environment overrides.
#
# docker-compose.yml falls back to the values below, which are meant for a
# local demo on your own machine only. To change them, copy this file to
# `.env` (already gitignored) and edit it before running START.bat / ./start.

# TimescaleDB
POSTGRES_DB=flead
POSTGRES_USER=flead
POSTGRES_PASSWORD=password

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Rows of each device file streamed by the producer; Spark evaluates the
# federated model on the remaining (held-out) rows. Devices have ~827 rows.
STREAM_ROWS_PER_DEVICE=660
