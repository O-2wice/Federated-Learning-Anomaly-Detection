# Dockerfile for Federated Aggregation Service
# Aggregates local models from devices using FedAvg

FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Make pip a bit more tolerant of slow networks (optional but helpful)
ENV PIP_DEFAULT_TIMEOUT=300

# Copy service-specific requirements
COPY requirements/aggregator.txt requirements.txt

# Install ONLY the libs the federated aggregator actually needs
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY scripts/config_loader.py ./scripts/
COPY scripts/04_federated_aggregation.py ./scripts/
COPY scripts/dashboard_metrics_updater.py ./scripts/

# Create models directory
RUN mkdir -p /app/models/{local,global}

# Set environment variables (database settings come from docker-compose;
# scripts/config_loader.py supplies local-demo defaults)
ENV PYTHONUNBUFFERED=1
ENV KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:9092

# Health check - verify DB connectivity using the container's DB settings
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import sys; sys.path.insert(0, 'scripts'); import psycopg2; from config_loader import get_db_config; psycopg2.connect(connect_timeout=5, **get_db_config())" || exit 1

# Run aggregator
CMD ["python", "scripts/04_federated_aggregation.py"]
