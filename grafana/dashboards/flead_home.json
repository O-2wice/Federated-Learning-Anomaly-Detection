    {
      "type": "stat",
      "title": "Readings / s",
      "description": "Collector throughput over the last 15-second snapshot interval. The producer sends 150 per second.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flead-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT GREATEST(0, (a.metric_value - b.metric_value) * 1 / NULLIF(EXTRACT(EPOCH FROM a.timestamp - b.timestamp), 0)) AS value FROM (SELECT metric_value, timestamp FROM dashboard_metrics WHERE metric_name = 'total_iot_count' ORDER BY timestamp DESC LIMIT 1) a CROSS JOIN LATERAL (SELECT metric_value, timestamp FROM dashboard_metrics WHERE metric_name = 'total_iot_count' AND timestamp <= a.timestamp - INTERVAL '60 seconds' ORDER BY timestamp DESC LIMIT 1) b"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
