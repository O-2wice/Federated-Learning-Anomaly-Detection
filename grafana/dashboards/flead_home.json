    {
      "type": "table",
      "title": "Confusion matrix (latest evaluation)",
      "description": "Counts of held-out readings by true label and model prediction.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flead-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH e AS (SELECT true_positives AS tp, false_positives AS fp, false_negatives AS fn, true_negatives AS tn FROM model_evaluations WHERE device_id = 'ALL' ORDER BY evaluation_timestamp DESC LIMIT 1) SELECT 'Attack' AS \"Actual\", tp AS \"Predicted attack\", fn AS \"Predicted benign\" FROM e UNION ALL SELECT 'Benign', fp, tn FROM e"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
