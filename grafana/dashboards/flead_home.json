    {
      "type": "timeseries",
      "title": "Held-out accuracy, F1 and baseline",
      "description": "Every new global version is scored on the same held-out sample.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flead-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT evaluation_timestamp AS time, model_accuracy AS \"Accuracy\" FROM model_evaluations WHERE device_id = 'ALL' AND $__timeFilter(evaluation_timestamp) ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT evaluation_timestamp AS time, f1_score AS \"F1\" FROM model_evaluations WHERE device_id = 'ALL' AND $__timeFilter(evaluation_timestamp) ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT evaluation_timestamp AS time, (true_negatives + false_positives)::float / NULLIF(sample_count, 0) AS \"Always-benign baseline\" FROM model_evaluations WHERE device_id = 'ALL' AND $__timeFilter(evaluation_timestamp) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "gradientMode": "none",
