    {
      "type": "timeseries",
      "title": "Local models per minute",
      "description": "Local training rounds reported to the aggregator (from the 15-second KPI snapshots).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flead-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "WITH s AS (SELECT time_bucket('1 minute', timestamp) AS t, MAX(metric_value) AS v FROM dashboard_metrics WHERE metric_name = 'total_local_models_count' AND $__timeFilter(timestamp) GROUP BY 1) SELECT t AS time, GREATEST(0, (v - LAG(v) OVER (ORDER BY t)) * 60 / NULLIF(EXTRACT(EPOCH FROM t - LAG(t) OVER (ORDER BY t)), 0)) AS \"Local models\" FROM s ORDER BY 1"
        }
