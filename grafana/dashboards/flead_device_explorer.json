          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT device_id AS \"Device\", COUNT(*) AS \"Anomalies\", COUNT(*) FILTER (WHERE severity = 'critical') AS \"Critical\", ROUND(AVG(label)::numeric * 100, 1) AS \"Attacks %\", MAX(ts) AS \"Last flagged\" FROM anomalies WHERE $__timeFilter(ts) GROUP BY device_id ORDER BY 2 DESC LIMIT 50"
