    {
      "type": "barchart",
      "title": "RRCF score of flagged readings",
      "description": "Scores are percentile ranks of the forest's collusive displacement (0 for the bottom 90%).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flead-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE WHEN anomaly_score < 0.4 THEN '< 0.40' ELSE to_char(LEAST(FLOOR(anomaly_score * 20) / 20, 0.95), 'FM0.00') END AS \"Score\", COUNT(*) AS \"Anomalies\" FROM anomalies WHERE $__timeFilter(ts) AND ('$device' = 'All' OR device_id = '$device') GROUP BY 1 ORDER BY MIN(anomaly_score)"
        }
      ],
      "fieldConfig": {
