    {
      "type": "timeseries",
      "title": "Detection quality over time (5-minute buckets)",
      "description": "Buckets Flink has not processed yet show low values; judge the older buckets.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flead-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flead-timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "WITH a AS (SELECT time_bucket('5 minutes', ts) AS t, COUNT(*) AS flagged, COUNT(*) FILTER (WHERE label = 1) AS flagged_attacks FROM anomalies WHERE $__timeFilter(ts) AND ('$device' = 'All' OR device_id = '$device') GROUP BY 1), r AS (SELECT time_bucket('5 minutes', ts) AS t, COUNT(*) AS readings, COUNT(*) FILTER (WHERE label = 1) AS attacks FROM iot_data WHERE $__timeFilter(ts) AND ('$device' = 'All' OR device_id = '$device') GROUP BY 1) SELECT r.t AS time, a.flagged_attacks::float / NULLIF(a.flagged, 0) AS \"Precision\", a.flagged_attacks::float / NULLIF(r.attacks, 0) AS \"Recall\", a.flagged::float / NULLIF(r.readings, 0) AS \"Share flagged\" FROM r LEFT JOIN a ON a.t = r.t ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Precision"
            },
            "properties": [
              {
                "id": "color",
                "value": {
